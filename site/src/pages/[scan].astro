---
// "Paste a link, get a report" — the browser-only part of Agent Guard Web.
// Behind a build-time feature flag: with PUBLIC_FEATURE_SCAN unset, no page is built.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import meta from "../data/generated/meta.json";
import engine from "../data/engine.json";
export function getStaticPaths() {
  return import.meta.env.PUBLIC_FEATURE_SCAN === "1" ? [{ params: { scan: "scan" } }] : [];
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base title="Scan" description="Scan an agent skill, MCP configuration or public GitHub link in your browser. Nothing is uploaded.">
  <div class="scan-head">
    <h1>Scan a skill, MCP config or link</h1>
    <p class="lead">The scanner runs entirely in your browser. Pasted text and dropped files never leave your device, and nothing you scan is sent to Agent Guard.</p>
    <ul class="scan-trust" aria-label="How results should be read">
      <li><Icon name="browser" class="icon small-icon" /> Runs on your device</li>
      <li><Icon name="lock" class="icon small-icon" /> Paste and files are never uploaded</li>
      <li><Icon name="eye" class="icon small-icon" /> Evidence for review, not a verdict</li>
    </ul>
  </div>

  <noscript>
    <div class="card"><p>This page needs JavaScript because the scanner runs on your device. The command-line scanner works without it:</p>
      <pre><code>uvx agentguard scan ./my-skill</code></pre></div>
  </noscript>

  <div id="scanner" class="scanner" hidden
       data-engine-sha={engine.engine_sha256}
       data-worker={`${base}/js/scan-worker.js`}>
    <div class="tabs" role="tablist" aria-label="What to scan">
      <button type="button" role="tab" id="tab-link" aria-controls="panel-link" aria-selected="true"><Icon name="globe" class="icon small-icon" />Link</button>
      <button type="button" role="tab" id="tab-paste" aria-controls="panel-paste" aria-selected="false" tabindex="-1"><Icon name="code" class="icon small-icon" />Paste</button>
      <button type="button" role="tab" id="tab-files" aria-controls="panel-files" aria-selected="false" tabindex="-1"><Icon name="file" class="icon small-icon" />Files</button>
    </div>

    <section id="panel-link" role="tabpanel" aria-labelledby="tab-link" class="panel">
      <form id="link-form" class="stack">
        <label for="link" class="field-label">Paste a link or package name</label>
        <div class="row">
          <input id="link" name="link" type="text" inputmode="url" autocomplete="off" spellcheck="false" required
                 aria-describedby="link-formats" placeholder="https://github.com/owner/repo/tree/main/skills/pdf" />
          <button type="submit" class="btn">Scan</button>
        </div>
        <ul id="link-formats" class="formats" aria-label="Supported inputs">
          <li><span>GitHub</span> repository, folder, file or gist</li>
          <li><span>npm</span><code>npm:@scope/server@1.2.0</code></li>
          <li><span>PyPI</span><code>pypi:name==1.0</code></li>
          <li><span>MCP Registry</span> server name</li>
          <li><span>Remote MCP</span><code>https://…/mcp</code></li>
        </ul>
      </form>
      <ul class="how" aria-label="How links are scanned">
        <li><Icon name="git" class="icon small-icon" /><div><strong>Pinned</strong> Each link is resolved to an exact commit or version, so the report says exactly what was scanned.</div></li>
        <li><Icon name="shield" class="icon small-icon" /><div><strong>Isolated</strong> The Agent Guard Web server fetches it and scans it in a sandbox with no network. The report gets an unlisted permalink.</div></li>
        <li><Icon name="plug" class="icon small-icon" /><div><strong>Read-only for remote servers</strong> A remote MCP server URL is checked as an unauthenticated client: it lists tools and never calls them.</div></li>
        <li><Icon name="check" class="icon small-icon" /><div><strong>No third parties</strong> Your browser does a moment of computation as the bot check. If the server is unavailable, GitHub links are scanned here instead, with files fetched from GitHub without cookies. Public sources only. <a href={`${base}/terms/`}>Terms</a>.</div></li>
      </ul>
    </section>

    <section id="panel-paste" role="tabpanel" aria-labelledby="tab-paste" class="panel" hidden>
      <form id="paste-form" class="stack">
        <label for="paste-text" class="field-label">Paste a SKILL.md, instruction file, MCP configuration or tool list</label>
        <textarea id="paste-text" rows="14" spellcheck="false" required placeholder="---&#10;name: my-skill&#10;description: …&#10;---"></textarea>
        <div class="row between">
          <div class="row">
            <label for="paste-kind" class="muted">Treat as</label>
            <select id="paste-kind">
              <option value="">Detect automatically</option>
              <option value="pasted-skill/SKILL.md">Agent skill (SKILL.md)</option>
              <option value="AGENTS.md">Instruction file (AGENTS.md, CLAUDE.md)</option>
              <option value=".cursor/rules/pasted.mdc">Cursor rule (.mdc)</option>
              <option value=".mcp.json">MCP client configuration (JSON)</option>
              <option value=".codex/config.toml">Codex configuration (TOML)</option>
              <option value="tools.json">MCP tool list (JSON)</option>
              <option value="server.json">MCP Registry server.json</option>
              <option value="pasted.py">Python</option>
              <option value="pasted.ts">JavaScript or TypeScript</option>
              <option value="pasted.sh">Shell script</option>
            </select>
          </div>
          <button type="submit" class="btn">Scan</button>
        </div>
      </form>
      <p class="local-note"><Icon name="lock" class="icon small-icon" /> Scanned on your device with no network requests.</p>
    </section>

    <section id="panel-files" role="tabpanel" aria-labelledby="tab-files" class="panel" hidden>
      <div id="drop" class="drop" tabindex="0" aria-describedby="drop-help">
        <Icon name="layers" class="icon drop-icon" />
        <p><strong>Drop a skill folder, files, or a .zip here</strong></p>
        <p id="drop-help" class="muted small">Or choose
          <label class="linklike"><input id="pick-files" type="file" multiple class="visually-hidden" /> files</label> or
          <label class="linklike"><input id="pick-folder" type="file" webkitdirectory multiple class="visually-hidden" /> a folder</label>
        </p>
      </div>
      <p class="local-note"><Icon name="lock" class="icon small-icon" /> Scanned on your device with no network requests. Archives are read in memory, never extracted to disk. Limits: 5,000 files, 2 MB per file, 64 MB in total.</p>
    </section>

    <div id="status" class="status" role="status" aria-live="polite" hidden>
      <span class="spinner" aria-hidden="true"></span>
      <span id="status-text"></span>
      <button type="button" id="cancel" class="btn secondary small">Cancel</button>
    </div>
    <div id="error" class="alert" role="alert" hidden></div>

    <section id="result" class="result" aria-labelledby="result-title" hidden></section>
  </div>

  <p class="muted small engine-note">Engine and rule pack {meta.rule_pack} ({meta.rule_count} rules) run in Pyodide {engine.pyodide_version}, served from this site. The first scan downloads about 15 MB; later scans reuse it. <a href={`${base}/rules/`}>What the rules detect</a>.</p>
  <script type="module" src={`${base}/js/scan-page.js`}></script>
</Base>
