---
// The header's dropdown panels (public/js/menus.js opens them from the nav items that carry
// data-menu). They sit outside nav.main, so the nav's own links stay the only ones in it.
import Icon from "./Icon.astro";
import ruleData from "../data/generated/rules.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const count = (prefix: string) => ruleData.rules.filter((r) => r.id.startsWith(prefix)).length;
const docs = [
  ["Get started", [["Install", "install", "uvx, pipx, and what Agent Guard needs"], ["Quickstart", "quickstart", "Scan your machine, a skill, a repo or a config"], ["How it works", "how-it-works", "The pipeline, severity rules and toxic flows"]]],
  ["Configure", [["Configuration", "config", "The .agentguard.yaml file"], ["Policy", "policy", "Allow and deny servers, pinning, maximum severity"], ["Suppressions", "suppressions", "Accepting findings with a reason and an expiry"]]],
  ["Integrate", [["CI integration", "ci", "GitHub Action with SARIF alerts, pre-commit"], ["Web scanner", "web-scanner", "Pasted text, files and GitHub links in the browser"], ["Library API", "library-api", "Use the engine from Python, workers or Pyodide"]]],
  ["Reference", [["CLI reference", "cli", "Every command and option"], ["Output formats", "output", "JSON, SARIF, Markdown, HTML, CycloneDX"], ["Limitations", "limitations", "What Agent Guard does not do"]]],
] as const;
// One entry per section of the rule catalog (src/pages/rules/index.astro), linked by its anchor.
const areas = [
  ["Skills", "AG-SKL-", "file", "Instruction files, bundles and hidden text"],
  ["MCP configs", "AG-MCP-CFG-", "plug", "How each server is started"],
  ["MCP metadata", "AG-MCP-META-", "layers", "Tool, prompt and resource descriptions"],
  ["Server code", "AG-CODE-", "code", "Where tool parameters end up"],
  ["Toxic flows", "AG-FLOW-", "alert", "Untrusted input, private data and egress"],
  ["Supply chain", "AG-SC-", "lock", "Lockfile drift, provenance and IOCs"],
  ["Remote auth", "AG-AUTH-", "key", "OAuth and TLS conformance"],
  ["Policy", "AG-POL-", "shield", "Allowlists, pinning and suppressions"],
  ["Coverage", "AG-SYS-", "scan", "What a scan could not read"],
] as const;
---
<div class="menu wide" data-menu-panel="docs" id="menu-docs">
  <div class="menu-cols">
    {docs.map(([head, items]) => (
      <div class="menu-col">
        <p class="menu-head">{head}</p>
        <ul>
          {items.map(([title, slug, text]) => (
            <li><a class="menu-item" href={`${base}/docs/${slug}/`}><b>{title}</b><span>{text}</span></a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="menu-foot">
    <a class="menu-all" href={`${base}/docs/`}>All documentation →</a>
    <ul><li><a href={`${base}/changelog/`}>Changelog</a></li><li><a href={`${base}/sample-report/`}>Sample report</a></li><li><a href={`${base}/security/`}>Security</a></li></ul>
  </div>
</div>
<div class="menu" data-menu-panel="rules" id="menu-rules">
  <ul class="menu-grid">
    {areas.map(([title, prefix, icon, text]) => (
      <li><a class="menu-item with-icon" href={`${base}/rules/#${prefix.toLowerCase().replace(/-$/, "")}`}><Icon name={icon} class="icon" /><span><b>{title} <em>{count(prefix)}</em></b><span>{text}</span></span></a></li>
    ))}
  </ul>
  <div class="menu-foot">
    <a class="menu-all" href={`${base}/rules/`}>All {ruleData.rules.length} rules →</a>
    <ul><li><a href={`${base}/coverage/`}>Coverage</a></li><li><a href={`${base}/benchmarks/`}>Benchmarks</a></li></ul>
  </div>
</div>
