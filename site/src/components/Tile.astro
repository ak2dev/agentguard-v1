---
// A bento tile. The corner markers sit on the bento grid as a whole (.blk.open).
interface Props { span?: string; tone?: "" | "orange"; class?: string }
const { span = "span-6", tone = "", class: cls = "" } = Astro.props;
---
<article class={`tile ${span} ${tone} ${cls}`.trim().replace(/\s+/g, " ")}>
  <slot />
</article>
