---
// One diagram node (SVG): a quiet card with a faint top sheen, a mono eyebrow,
// a name and a role. tone "hot" adds the orange left rule used on finding cards;
// "solid" is the single focal node, filled with the brand orange. Size boxes
// with measure.js nodeW() so the text keeps PAD on both sides.
import { PAD } from "./measure.js";
interface Props {
  x: number; y: number; w: number; h?: number;
  eyebrow?: string; name: string; role?: string;
  tone?: "plain" | "hot" | "solid"; align?: "start" | "middle";
}
const { x, y, w, h = 74, eyebrow, name, role, tone = "plain", align = "middle" } = Astro.props;
const tx = align === "middle" ? x + w / 2 : x + PAD;
// Center the text block vertically: eyebrow cap height (~7) to role descenders (~3).
const block = (eyebrow ? 22 : 0) + (role ? 18 : 0) + 10;
const top = y + (h - block) / 2 + 7 + (eyebrow ? 0 : -22);
---
<g class={`node node-${tone}`}>
  <rect class="node-card" x={x} y={y} width={w} height={h} rx="10" />
  <line class="node-sheen" x1={x + 10} x2={x + w - 10} y1={y + 0.75} y2={y + 0.75} />
  {tone === "hot" && <rect class="node-rule" x={x + 1} y={y + 14} width="2.5" height={h - 28} rx="1.25" />}
  {eyebrow && <text class="node-eyebrow" x={tx} y={top} text-anchor={align}>{eyebrow.toUpperCase()}</text>}
  <text class="node-name" x={tx} y={top + 22} text-anchor={align}>{name}</text>
  {role && <text class="node-role" x={tx} y={top + 40} text-anchor={align}>{role}</text>}
</g>
