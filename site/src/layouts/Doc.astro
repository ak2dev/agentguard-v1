---
import Base from "./Base.astro";
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname;
const docs = [
  ["Install", "install"], ["Quickstart", "quickstart"], ["How it works", "how-it-works"], ["CLI reference", "cli"],
  ["Configuration", "config"], ["Policy", "policy"], ["Suppressions", "suppressions"], ["CI integration", "ci"],
  ["Web scanner", "web-scanner"], ["Output formats", "output"], ["Library API", "library-api"], ["Limitations", "limitations"],
];
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="doc-layout">
    <nav aria-label="Documentation" class="doc-nav">
      <ul>
        {docs.map(([label, slug]) => {
          const href = `${base}/docs/${slug}/`;
          return <li><a href={href} aria-current={path === href ? "page" : undefined}>{label}</a></li>;
        })}
      </ul>
    </nav>
    <article class="doc">
      <slot />
    </article>
  </div>
</Base>
