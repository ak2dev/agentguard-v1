---
import "@fontsource-variable/inter/opsz.css";
// The Latin subset of Inter is preloaded so it is ready for the first frame of every page;
// otherwise each navigation paints the nav in a fallback font and then shifts when Inter loads.
import interLatin from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";

interface Props { title: string; description?: string; wide?: boolean }
const { title, description = "Offline-first security scanner for AI agent skills, instruction files and MCP servers." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const scanEnabled = import.meta.env.PUBLIC_FEATURE_SCAN === "1";
const path = Astro.url.pathname;
const nav = [
  ...(scanEnabled ? [["Scan", "/scan/"]] : []),
  ["Docs", "/docs/"],
  ["Rules", "/rules/"],
  ["Coverage", "/coverage/"],
  ["Benchmarks", "/benchmarks/"],
  ["Security", "/security/"],
];
const csp = "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0d0c" />
    <meta name="description" content={description} />
    <title>{title === "Agent Guard" ? title : `${title} · Agent Guard`}</title>
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={`${base}/`}><Wordmark /></a>
        <nav class="main" aria-label="Main">
          <ul>
            {nav.map(([label, href]) => (
              <li><a href={`${base}${href}`} aria-current={path.startsWith(`${base}${href}`) ? "page" : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="bar-actions">
          <a class="btn secondary" href={`${base}/docs/install/`}>Install</a>
          {scanEnabled && <a class="btn" href={`${base}/scan/`}>Scan a link</a>}
        </div>
      </div>
    </header>
    <main id="content">
      <slot name="hero" />
      <div class="frame">
        <div class="wrap main-inner">
          <slot />
        </div>
      </div>
    </main>
    <div class="frame">
      <footer class="site">
        <div class="wrap">
          <div class="foot">
            <div>
              <a class="brand" href={`${base}/`}><Wordmark /></a>
              <p>Open source (Apache-2.0). No analytics, no cookies, no third-party requests.</p>
              <p>Findings are evidence for review, not verdicts. A scan with no findings never means "safe".</p>
            </div>
            <div>
              <h2>Product</h2>
              <ul>
                {scanEnabled && <li><a href={`${base}/scan/`}>Web scanner</a></li>}
                <li><a href={`${base}/docs/install/`}>Install</a></li>
                <li><a href={`${base}/sample-report/`}>Sample report</a></li>
                <li><a href={`${base}/changelog/`}>Changelog</a></li>
              </ul>
            </div>
            <div>
              <h2>Evidence</h2>
              <ul>
                <li><a href={`${base}/rules/`}>Rule catalog</a></li>
                <li><a href={`${base}/coverage/`}>Standards coverage</a></li>
                <li><a href={`${base}/benchmarks/`}>Benchmarks</a></li>
                <li><a href={`${base}/docs/limitations/`}>Limitations</a></li>
              </ul>
            </div>
            <div>
              <h2>Trust</h2>
              <ul>
                <li><a href={`${base}/security/`}>Security</a></li>
                <li><a href={`${base}/privacy/`}>Privacy</a></li>
                <li><a href={`${base}/.well-known/security.txt`}>security.txt</a></li>
              </ul>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
