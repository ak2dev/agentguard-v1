---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";

interface Props { title: string; description?: string; wide?: boolean }
const { title, description = "Offline-first security scanner for AI agent skills, instruction files and MCP servers.", wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname;
const nav = [
  ...(import.meta.env.PUBLIC_FEATURE_SCAN === "1" ? [["Scan", "/scan/"]] : []),
  ["Docs", "/docs/"],
  ["Rules", "/rules/"],
  ["Coverage", "/coverage/"],
  ["Benchmarks", "/benchmarks/"],
  ["Sample report", "/sample-report/"],
  ["Security", "/security/"],
  ["Changelog", "/changelog/"],
];
const csp = "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <title>{title === "Agent Guard" ? title : `${title} · Agent Guard`}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={`${base}/`}><Wordmark /></a>
        <nav class="main" aria-label="Main">
          <ul>
            {nav.map(([label, href]) => (
              <li><a href={`${base}${href}`} aria-current={path.startsWith(`${base}${href}`) ? "page" : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>Agent Guard is open source (Apache-2.0). This site uses no analytics, no cookies and no third-party requests.
          Findings are evidence for review, not verdicts; a clean scan never means "safe".</p>
      </div>
    </footer>
  </body>
</html>
