{
  "inputs": [
    {
      "type": "promptString",
      "id": "token",
      "description": "API token",
      "password": true
    }
  ],
  "servers": {
    "docs": {
      "type": "http",
      "url": "https://mcp.example.invalid/mcp",
      "headers": {
        "Authorization": "Bearer ${input:token}"
      }
    }
  }
}